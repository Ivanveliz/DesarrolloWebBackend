extends layout

block content
  section.form-card
    h2= isEdit ? 'Editar Producto' : 'Crear Nuevo Producto'
    
    - const productoId = producto && (producto._id || producto.id)
    - const actionUrl = isEdit && productoId ? `/productos/${productoId}?_method=PUT` : '/productos'
    
    form(action=actionUrl, method="POST")
      label Nombre del Producto
        input(type="text", name="nombre", required, value=(isEdit && producto ? producto.nombre : ''))
      
      label Categoría
        input(type="text", name="categoria", required, value=(isEdit && producto ? producto.categoria : ''))
      
      div.grid
        label Precio
          input(type="number", name="precio", step="0.01", min="0", required, value=(isEdit && producto ? producto.precio : ''))
        
        label Stock Disponible
          input(type="number", name="stock", min="0", required, value=(isEdit && producto ? producto.stock : ''))
      
      .form-actions
        button(type="submit", class="btn btn-primary")= isEdit ? 'Guardar Cambios' : 'Crear Producto'
        a(href="/productos", class="btn btn-secondary btn-sm") Cancelar