extends layout

block content
  section.page-header
    .header-title
      h2 Productos
      p Administrar el catálogo y verificar stock en tiempo real.
    if user && user.role === 'admin'
      a(href="/productos/nuevo", class="btn btn-primary btn-sm") + Nuevo producto

  if productos.length === 0
    section.card
      p No hay productos registrados todavía en la base de datos.
  else
    section.table-card
      table
        thead
          tr
            th ID
            th Nombre
            th Categoría
            th Precio
            th Stock
            if user && user.role === 'admin'
              th Acciones
        tbody
          each producto, index in productos
            tr
              td= index + 1
              td= producto.nombre
              td= producto.categoria
              td $#{producto.precio}
              td= producto.stock
              if user && user.role === 'admin'
                td.actions-col
                  .action-buttons
                    a(href=`/productos/${producto._id}/editar`, class="btn btn-secondary btn-icon btn-icon-edit", aria-label="Editar", title="Editar")
                      svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                        path(d="M4 20H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                        path(d="M14.5 4.5L19.5 9.5L9 20H4V15L14.5 4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                    form(action=`/productos/${producto._id}?_method=DELETE`, method="POST", onsubmit="return confirm('¿Eliminar producto?');")
                      button(type="submit", class="btn btn-icon btn-icon-danger", aria-label="Eliminar", title="Eliminar")
                        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                          path(d="M6 7H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                          path(d="M8 7V18C8 18.5523 8.44772 19 9 19H15C15.5523 19 16 18.5523 16 18V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                          path(d="M10 7V5.5C10 5.22386 10.2239 5 10.5 5H13.5C13.7761 5 14 5.22386 14 5.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
