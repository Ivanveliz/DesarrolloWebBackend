extends layout

block content
  section.page-header
    div.header-title
      h2 Empleados
      p Gestiona los empleados registrados en el sistema.
    a(href="/empleados/nuevo", class="btn btn-primary btn-sm")
      | + Nuevo empleado

  if !employees || employees.length === 0
    section.card
      p No hay empleados registrados todavía.
  else
    section.table-card
      table
        thead
          tr
            th ID
            th Nombre y Apellido
            th DNI
            th Puesto
            th Turno
            th Acciones
        tbody
          each emp, index in employees
            - const empId = emp._id || emp.id || "";
            tr
              td= index + 1
              td #{emp.name || ""} #{emp.surname || ""}
              td= emp.dni || "Sin DNI"
              td= emp.role || "Sin puesto"
              td= emp.shift || "Sin turno"
              td.actions-col
                .action-buttons
                  if empId
                    a(href=`/empleados/${empId}/editar`, class="btn btn-secondary btn-icon btn-icon-edit", aria-label="Editar", title="Editar")
                      svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                        path(d="M4 20H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                        path(d="M14.5 4.5L19.5 9.5L9 20H4V15L14.5 4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")

                    form(action=`/empleados/${empId}?_method=DELETE`, method="POST", onsubmit="return confirm('¿Seguro que deseas eliminar este empleado?');")
                      button(type="submit", class="btn btn-icon btn-icon-danger", aria-label="Eliminar", title="Eliminar")
                        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                          path(d="M6 7H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                          path(d="M8 7V18C8 18.5523 8.44772 19 9 19H15C15.5523 19 16 18.5523 16 18V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                          path(d="M10 7V5.5C10 5.22386 10.2239 5 10.5 5H13.5C13.7761 5 14 5.22386 14 5.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                  else
                    | Sin acciones