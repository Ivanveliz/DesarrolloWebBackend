extends layout

block content
  h2 Lista de Empleados 

  if user && user.role !== 'operario'
    a(href="/nuevo", role="button", class="outline") + Nuevo Empleado
  
  if employees.length === 0
    p No hay empleados registrados todavía.
  else
    figure
      table
        thead
          tr
            th ID
            th Nombre y Apellido
            th DNI
            th Puesto
            th Turno
            th Acciones
        tbody
          each emp, index in employees
            tr
              td= index + 1
              td #{emp.name} #{emp.surname}
              td= emp.dni
              td= emp.role
              td= emp.shift
              td.actions-col
                if user && user.role !== 'operario'
                  a(href=`/${emp._id}/editar`, role="button", class="secondary outline") Editar

                  //- Al apretar el botón, esto envía un método DELETE procesado por method-override
                  
                  form(action=`/${emp._id}?_method=DELETE`, method="POST", onsubmit="return confirm('¿Estás seguro de que deseas eliminar este empleado?');")
                    button(type="submit", class="outline contrast") Borrar
