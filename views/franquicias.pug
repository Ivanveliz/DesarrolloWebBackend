extends layout

block content
  section.page-header
    .header-title
      h2 Franquicias
      p Gestiona las franquicias registradas y consulta sus datos.
    a(href="/franquicias/nuevo", class="btn btn-primary btn-sm") + Nueva Franquicia

  if franquicias.length === 0
    section.card
      p No hay franquicias registradas.
  else
    section.table-card
      table
        thead
          tr
            th ID
            th Razón Social
            th CUIT
            th Localidad
            th Encargado
            th Teléfono
            th Acciones
        tbody
          each franquicia, index in franquicias
            tr
              td= index + 1
              td= franquicia.razonSocial
              td= franquicia.cuit
              td= franquicia.localidad
              td= franquicia.encargado
              td= franquicia.telefono
              td.actions-col
                .action-buttons
                  a(href=`/franquicias/${franquicia._id}/editar`, class="btn btn-secondary btn-icon btn-icon-edit", aria-label="Editar", title="Editar")
                    svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                      path(d="M4 20H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                      path(d="M14.5 4.5L19.5 9.5L9 20H4V15L14.5 4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  form(action=`/franquicias/${franquicia._id}?_method=DELETE`, method="POST", onsubmit="return confirm('¿Estás seguro de eliminar esta franquicia?');")
                    button(type="submit", class="btn btn-icon btn-icon-danger", aria-label="Eliminar", title="Eliminar")
                      svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                        path(d="M6 7H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                        path(d="M8 7V18C8 18.5523 8.44772 19 9 19H15C15.5523 19 16 18.5523 16 18V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                        path(d="M10 7V5.5C10 5.22386 10.2239 5 10.5 5H13.5C13.7761 5 14 5.22386 14 5.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")