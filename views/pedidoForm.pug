extends layout

block content
  h2= isEdit ? 'Editar Pedido' : 'Crear Nuevo Pedido'
  
  - const actionUrl = isEdit ? `/pedidos/${pedido._id}?_method=PUT` : '/pedidos'
  - const initialItems = isEdit && pedido && pedido.productos && pedido.productos.length ? pedido.productos : [null]
  
  form(action=actionUrl, method="POST", class="card form-card")
    fieldset
      legend Datos del pedido
      label Franquicia
        select(name="franquiciaId", required)
          option(value="", disabled, selected=!isEdit) Elija una franquicia...
          each franq in franquicias
            option(value=franq._id, selected=(isEdit && pedido.franquiciaId && pedido.franquiciaId.toString() === franq._id.toString()))= franq.razonSocial

    section.products-section
      h3 Productos
      div.products-grid
        each item, index in initialItems
          .product-row(data-index=index)
            label
              span.product-label Producto #{index + 1}
              select(name=`productos[${index}][productoId]`, required)
                option(value="", disabled, selected=!item) Elija un producto...
                each prod in productos
                  option(value=prod._id, selected=(item && item.productoId && item.productoId.toString() === prod._id.toString()))= prod.nombre
            label
              span Cantidad
              input(type="number", name=`productos[${index}][cantidad]`, min="1", required, value=(item ? item.cantidad : 1))
            if index > 0
              button(type="button", class="btn btn-secondary btn-icon btn-sm remove-product", aria-label="Eliminar producto", title="Eliminar producto")
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M6 7H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                  path(d="M8 7V18C8 18.5523 8.44772 19 9 19H15C15.5523 19 16 18.5523 16 18V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M10 7V5.5C10 5.22386 10.2239 5 10.5 5H13.5C13.7761 5 14 5.22386 14 5.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
      button(type="button", id="add-product", class="btn btn-secondary btn-sm") + Agregar producto

    if isEdit
      label Estado del Pedido
        select(name="estado", required)
          option(value="pendiente", selected=pedido.estado==="pendiente") Pendiente
          if user && user.role === 'admin'
            option(value="en proceso", selected=pedido.estado==="en proceso") En Proceso
            option(value="completado", selected=pedido.estado==="completado") Completado
          option(value="cancelado", selected=pedido.estado==="cancelado") Cancelado

    div.form-actions
      button(type="submit", class="btn btn-primary")= isEdit ? 'Guardar Cambios' : 'Crear Pedido'
      a(href="/pedidos", class="btn btn-secondary btn-sm") Cancelar
  template#product-row-template
    .product-row
      label
        span.product-label Producto __INDEX__
        select(name="productos[__INDEX__][productoId]", required)
          option(value="", disabled, selected) Elija un producto...
          each prod in productos
            option(value=prod._id)= prod.nombre
      label
        span Cantidad
        input(type="number", name="productos[__INDEX__][cantidad]", min="1", required, value="1")
      button(type="button", class="btn btn-secondary btn-icon btn-sm remove-product", aria-label="Eliminar producto", title="Eliminar producto")
        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
          path(d="M6 7H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
          path(d="M8 7V18C8 18.5523 8.44772 19 9 19H15C15.5523 19 16 18.5523 16 18V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
          path(d="M10 7V5.5C10 5.22386 10.2239 5 10.5 5H13.5C13.7761 5 14 5.22386 14 5.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")

  script.
    const addProductBtn = document.getElementById('add-product');
    const productsGrid = document.querySelector('.products-grid');
    const template = document.getElementById('product-row-template');
    let nextIndex = productsGrid ? productsGrid.children.length : 1;

    function createProductRow(index) {
      const html = template.innerHTML.replace(/__INDEX__/g, index);
      const wrapper = document.createElement('div');
      wrapper.innerHTML = html.trim();
      const row = wrapper.firstElementChild;
      const removeBtn = row.querySelector('.remove-product');
      removeBtn.addEventListener('click', () => {
        row.remove();
        updateRowLabels();
      });
      return row;
    }

    function updateRowLabels() {
      const rows = document.querySelectorAll('.products-grid .product-row');
      rows.forEach((row, index) => {
        row.dataset.index = index;
        const labelSpan = row.querySelector('.product-label');
        const select = row.querySelector('select');
        const input = row.querySelector('input[type="number"]');
        const removeBtn = row.querySelector('.remove-product');
        if (labelSpan) {
          labelSpan.textContent = `Producto ${index + 1}`;
        }
        if (select) select.name = `productos[${index}][productoId]`;
        if (input) input.name = `productos[${index}][cantidad]`;
        if (removeBtn) {
          removeBtn.style.display = index === 0 ? 'none' : 'inline-flex';
        }
      });
    }

    if (productsGrid) {
      productsGrid.querySelectorAll('.remove-product').forEach(btn => {
        btn.addEventListener('click', event => {
          event.target.closest('.product-row').remove();
          updateRowLabels();
        });
      });
    }

    addProductBtn?.addEventListener('click', () => {
      const row = createProductRow(nextIndex);
      productsGrid.appendChild(row);
      nextIndex += 1;
      updateRowLabels();
    });

    updateRowLabels();
