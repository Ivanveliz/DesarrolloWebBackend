extends layout

block content
  section.form-card
    h2= isEdit ? 'Editar Franquicia' : 'Registrar Nueva Franquicia'

    if error
      p.message-error= error

    //- Sacamos el role=admin ya que ahora tenemos JWT y el authMiddleware leyendo req.user.role, no necesitamos ensuciar las URLs
    - const franquiciaId = franquicia && (franquicia._id || franquicia.id)
    - const actionUrl = isEdit && franquiciaId ? `/franquicias/${franquiciaId}?_method=PUT` : '/franquicias'

    form(action=actionUrl, method="POST")
      label Razón Social (nombre comercial)
        input(
          type="text",
          name="razonSocial",
          required,
          value=(isEdit && franquicia ? franquicia.razonSocial : '')
        )

      label CUIT
        input(
          type="text",
          name="cuit",
          required,
          inputmode="numeric",
          pattern="[0-9]{11}",
          title="El CUIT debe tener 11 números, sin letras, puntos ni guiones.",
          placeholder="Ej: 30712345678",
          value=(isEdit && franquicia ? franquicia.cuit : '')
        )
        small El CUIT debe tener 11 números, sin letras, puntos ni guiones.

      label Dirección Comercial
        input(
          type="text",
          name="direccion",
          required,
          value=(isEdit && franquicia ? franquicia.direccion : '')
        )

      label Localidad
        input(
          type="text",
          name="localidad",
          required,
          value=(isEdit && franquicia ? franquicia.localidad : '')
        )

      label Correo Electrónico
        input(
          type="email",
          name="correo",
          required,
          value=(isEdit && franquicia ? franquicia.correo : '')
        )

      label Encargado
        input(
          type="text",
          name="encargado",
          required,
          value=(isEdit && franquicia ? franquicia.encargado : '')
        )

      label Teléfono
        input(
          type="text",
          name="telefono",
          required,
          value=(isEdit && franquicia ? franquicia.telefono : '')
        )

      .form-actions
        button(type="submit", class="btn btn-primary")
          = isEdit ? 'Guardar Cambios' : 'Crear Franquicia'
        a(href="/franquicias", class="btn btn-secondary btn-sm") Cancelar