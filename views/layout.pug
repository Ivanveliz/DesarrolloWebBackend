doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Panadería - Gestión de Empleados
    
    //Libreria de estilos para no escribir mucho css
  
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css")
    link(rel="stylesheet", href="/css/styles.css")
    
    style.
      .actions-col { white-space: nowrap; width: 1%; }
      .actions-col form { display: inline-block; margin-bottom: 0; }
      .actions-col a { margin-right: 0.5rem; }
      .logout-btn { transition: background-color 0.3s, border-color 0.3s, color 0.3s; }
      .logout-btn:hover { background-color: #d32f2f !important; border-color: #d32f2f !important; color: white !important; }
  body
    main.container
      h1 Panadería "El Sol"
      
      if user
        div(style="display: flex; justify-content: space-between; align-items: center; margin-top: -1rem; margin-bottom: 2rem; border-bottom: 1px solid var(--pico-muted-border-color); padding-bottom: 1rem;")
          div(style="color: var(--pico-muted-color);")
            strong ¡Bienvenido, #{user.email}!
            br
            small Rol: #{user.role}
          div
            a(href="/logout", role="button", class="outline secondary logout-btn", style="margin-bottom: 0;", onclick="return confirm('¿Estás seguro de que deseas cerrar sesión?');") Cerrar sesión

      nav
        ul
          li: a(href="/") Lista de Empleados
          if user && user.role !== 'operario'
            li: a(href="/nuevo", role="button", class="outline") + Nuevo Empleado
          if user && user.role === 'admin'
            li: a(href="/franquicias?role=admin") Franquicias
          li: a(href="/pedidos") Pedidos
      
      block content
