doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Sistema de Gestión Interna - Panadería
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css")
    link(rel="stylesheet", href="/css/styles.css")
  body
    header.site-header
      .site-shell
        .brand
          h1 Panadería "La Espiga de Oro"
          p.subline Sistema de gestión interna para franquicias, productos, pedidos y empleados
        if user
          .user-panel
            span.user-badge(role="status")
              span.nav-icon
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M12 2C10.3431 2 9 3.34315 9 5C9 6.65685 10.3431 8 12 8C13.6569 8 15 6.65685 15 5C15 3.34315 13.6569 2 12 2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M5 22C5 18.134 8.13401 15 12 15C15.866 15 19 18.134 19 22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
              strong #{user.email}
            span.role-badge= user.role === 'admin' ? 'Administrador' : 'Operario'
            a(href="/logout", role="button", class="btn btn-secondary btn-sm btn-icon logout-btn", onclick="return confirm('¿Estás seguro de que deseas cerrar sesión?');")
              span.nav-icon
                svg(width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M12 3V12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M5.636 6.343a9 9 0 1 0 12.728 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
              
    block nav
      nav.site-nav
        .site-shell
          ul
            li: a(href="/", class="nav-link")
              span.nav-icon
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M3 11.5L12 4L21 11.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M6 21V12H18V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
              | Inicio
            li: a(href="/pedidos", class="nav-link")
              span.nav-icon
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M9 2H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M7 6H17C18.1046 6 19 6.89543 19 8V20C19 21.1046 18.1046 22 17 22H7C5.89543 22 5 21.1046 5 20V8C5 6.89543 5.89543 6 7 6Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M9 11H15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M9 15H13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
              | Pedidos
            li: a(href="/productos", class="nav-link")
              span.nav-icon
                svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                  path(d="M21 16V8C21 6.89543 20.1046 6 19 6H5C3.89543 6 3 6.89543 3 8V16C3 17.1046 3.89543 18 5 18H19C20.1046 18 21 17.1046 21 16Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M3 8L12 4L21 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                  path(d="M12 4V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
              | Productos
            if user && user.role === 'admin'
              li: a(href="/franquicias", class="nav-link")
                span.nav-icon
                  svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                    path(d="M3 21V8L12 3L21 8V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M7 21V12H17V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M10 21V14H14V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                | Franquicias
              li: a(href="/empleados", class="nav-link")
                span.nav-icon
                  svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                    path(d="M16 21V19C16 16.7909 14.2091 15 12 15H12C9.79086 15 8 16.7909 8 19V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                | Empleados
    main.container
      block content