extends layout

block content
  section.page-header
    div.header-title
      h2 Pedidos
      p Gestiona y revisa los pedidos de tus franquicias.
    a(href="/pedidos/nuevo", class="btn btn-primary btn-sm")
      | + Nuevo pedido

  div#pedido-alerta.socket-alert(style="display: none;")
    | Nuevo pedido recibido. Actualizando listado...

  if !pedidos || pedidos.length === 0
    section.card
      p No hay pedidos registrados
  else
    section.table-card
      table
        thead
          tr
            th ID Pedido
            th Franquicia
            th Estado
            th Fecha
            th Acciones
        tbody
          each pedido in pedidos
            - const pedidoId = pedido.id || pedido._id
            - const pedidoFecha = pedido.fecha || pedido.createdAt
            - const estado = pedido.estado || "pendiente"
            - const franquiciaNombre = pedido.franquiciaNombre || (pedido.franquiciaId && typeof pedido.franquiciaId === "object" ? pedido.franquiciaId.razonSocial || pedido.franquiciaId.nombre || pedido.franquiciaId.nombreFantasia : null) || "No asignado"

            tr
              td= pedidoId ? pedidoId.toString().slice(-6) : "SIN ID"

              td= franquiciaNombre

              td
                span(class=estado)= estado

              td= pedidoFecha ? new Date(pedidoFecha).toLocaleDateString() : "Sin fecha"

              td.actions-col
                .action-buttons
                  if pedidoId
                    a(href=`/pedidos/${pedidoId}`, class="btn btn-secondary btn-icon btn-icon-view", aria-label="Ver", title="Ver")
                      svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                        circle(cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8")
                        path(d="M16.6569 16.6569L20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")

                    a(href=`/pedidos/${pedidoId}/editar`, class="btn btn-secondary btn-icon btn-icon-edit", aria-label="Editar", title="Editar")
                      svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                        path(d="M4 20H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                        path(d="M14.5 4.5L19.5 9.5L9 20H4V15L14.5 4.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")

                    form(action=`/pedidos/${pedidoId}?_method=DELETE`, method="POST", onsubmit="return confirm('¿Seguro que deseas eliminar este pedido?');")
                      button(type="submit", class="btn btn-icon btn-icon-danger", aria-label="Eliminar", title="Eliminar")
                        svg(width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
                          path(d="M6 7H18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                          path(d="M8 7V18C8 18.5523 8.44772 19 9 19H15C15.5523 19 16 18.5523 16 18V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
                          path(d="M10 7V5.5C10 5.22386 10.2239 5 10.5 5H13.5C13.7761 5 14 5.22386 14 5.5V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round")
                  else
                    | Sin acciones

  script(src="/socket.io/socket.io.js")
  script(src="/js/pedidosSocket.js")