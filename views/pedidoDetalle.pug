extends layout

block content
  - const pedidoId = pedido && (pedido._id || pedido.id)
  - const numeroPedido = pedido && pedido.numeroPedido ? pedido.numeroPedido : null

  section.page-header
    div.header-title
      h2 Detalle del Pedido
      if numeroPedido
        small Pedido N° #{numeroPedido}
      else
        small Pedido sin número

    a(href="/pedidos", class="btn btn-secondary btn-sm") Volver a pedidos

  if !pedido
    section.card
      p No se encontró el pedido.
  else
    section.card.detail-grid
      p
        strong Pedido N°:
        |  #{numeroPedido || "Sin número"}

      p
        strong Franquicia:
        if pedido.franquiciaId && pedido.franquiciaId.razonSocial
          |  #{pedido.franquiciaId.razonSocial}
        else if pedido.franquiciaNombre
          |  #{pedido.franquiciaNombre}
        else if pedido.franquiciaId
          |  #{pedido.franquiciaId}
        else
          |  No asignado

      p
        strong Estado:
        |  
        span(class=pedido.estado) #{(pedido.estado || "pendiente").toUpperCase()}

      p
        strong Fecha:
        if pedido.fecha
          |  #{new Date(pedido.fecha).toLocaleString()}
        else
          |  Sin fecha

    section.card
      h3 Productos del pedido

      if !pedido.productos || pedido.productos.length === 0
        p No hay productos cargados en este pedido.
      else
        table
          thead
            tr
              th Producto
              th Categoría
              th Precio Unitario
              th Cantidad
              th Subtotal
          tbody
            - let total = 0
            each item in pedido.productos
              - const producto = item.productoId || null
              - const nombreProducto = producto && producto.nombre ? producto.nombre : "Producto sin nombre"
              - const categoriaProducto = producto && producto.categoria ? producto.categoria : "Sin categoría"
              - const precioProducto = producto && producto.precio ? producto.precio : 0
              - const cantidadProducto = item.cantidad || 0
              - const subtotal = precioProducto * cantidadProducto
              - total += subtotal

              tr
                td= nombreProducto
                td= categoriaProducto
                td= precioProducto ? `$${precioProducto}` : "Sin precio"
                td= cantidadProducto
                td= subtotal ? `$${subtotal}` : "-"

          tfoot
            tr
              td(colspan="4", style="text-align: right; font-weight: bold;") Total del Pedido:
              td(style="font-weight: bold;") $#{total}

    if pedidoId
      div.action-buttons
        a(href=`/pedidos/${pedidoId}/editar`, class="btn btn-secondary") Editar
        form(action=`/pedidos/${pedidoId}?_method=DELETE`, method="POST", onsubmit="return confirm('¿Seguro que deseas eliminar este pedido?');")
          button(type="submit", class="btn btn-danger") Eliminar