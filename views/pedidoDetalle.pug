extends layout

block content
  section.page-header
    .header-title
      h2 Detalle del Pedido
      small (ID: #{pedido._id.toString().slice(-6)})

  section.card.detail-grid
    p
      strong Franquicia:
      |  #{pedido.franquiciaId.razonSocial}
    p
      strong Estado:
      span(class=pedido.estado)= ` ${pedido.estado.toUpperCase()}`
    p
      strong Fecha:
      |  #{new Date(pedido.fecha).toLocaleString()}

  h3 Productos Solicitados
  if pedido.productos && pedido.productos.length > 0
    section.table-card
      table
        thead
          tr
            th Producto
            th Categoría
            th Precio Unitario
            th Cantidad
            th Subtotal
        tbody
          - let total = 0
          each item in pedido.productos
            if item.productoId
              - const subtotal = item.productoId.precio * item.cantidad
              - total += subtotal
              tr
                td= item.productoId.nombre
                td= item.productoId.categoria
                td $#{item.productoId.precio}
                td= item.cantidad
                td $#{subtotal}
        tfoot
          tr
            td(colspan="4", style="text-align: right; font-weight: bold;") Total del Pedido:
            td(style="font-weight: bold;") $#{total}
  else
    section.card
      p No hay productos válidos en este pedido.

  .form-actions
    a(href="/pedidos", class="btn btn-secondary btn-sm") Volver a Pedidos
